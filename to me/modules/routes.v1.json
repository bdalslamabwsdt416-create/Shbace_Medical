      "note": "Specialty selection within the question-bank hierarchy."
    },
    {
      "id": "topics",
      "title": "Topics",
      "group": "learning",
      "renderer": "core-switch",
      "backTarget": "specialties",
      "addressable": true,
      "remoteV2": true,
