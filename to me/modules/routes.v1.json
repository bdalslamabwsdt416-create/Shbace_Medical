{
  "schemaVersion": 1,
  "title": "SHBACE Medical Android navigation route inventory",
  "target": "android-apk",
  "frozenAndroidRelease": {
    "applicationId": "com.shbace.medical",
    "versionName": "1.3.9",
    "versionCode": 18
  },
  "sourceFiles": [
    "to me/js/04-app-main.js",
    "to me/js/09-app-features-v6.js",
    "to me/js/36-exam-planner-settings-smartreview.js",
    "to me/js/45-android-remote-content.js",
    "to me/js/46-android-remote-ui.js",
    "to me/js/47-android-remote-control.js",
    "to me/js/10-history-sync.js"
  ],
  "renderModel": {
    "currentRouteVariable": "appPage",
    "renderFunction": "renderAppDemo",
    "historyStateFields": [
      "m",
      "s",
      "p",
      "c"
    ],
    "historyNote": "js/10-history-sync.js mirrors appPage in local browser history; this is not cross-device account synchronization.",
    "defaultRender": "menuView"
  },
  "remoteAllowLists": {
    "androidRemoteUiV1": [
      "subjects",
      "specialties",
      "topics",
      "questions",
      "quiz",
      "quizrun",
      "quizresult",
      "quizhistory",
      "review",
      "stats",
      "search",
      "settings",
      "about",
      "changelog",
      "feedback",
      "rate",
      "pinned",
      "saved",
      "wrong",
      "reported",
      "notifs",
      "timer"
    ],
    "androidRemoteControlV3": [
      "subjects",
      "grade",
      "specialties",
      "topics",
      "questions",
      "quiz",
      "quizrun",
      "quizresult",
      "quizhistory",
      "review",
      "stats",
      "search",
      "settings",
      "about",
      "dedication",
      "changelog",
      "feedback",
      "rate",
      "pinned",
      "saved",
      "wrong",
      "reported",
      "notifs",
      "timer",
      "weak",
      "menu"
    ],
    "notes": "The V3 allow-list is broader than V2. A route can exist in the app without being an allowed target in both remote-navigation engines."
  },
  "dynamicRemotePage": {
    "routePrefix": "shbRemotePage_",
    "registration": "window.__shbRegisterPage",
    "rendererSource": "to me/js/46-android-remote-ui.js",
    "allowRemoteMarkup": false,
    "note": "Each page id is generated from validated declarative JSON blocks; page code is not downloaded or evaluated."
  },
  "registeredLocalPages": [
    {
      "id": "examplanner",
      "registrationFile": "to me/js/36-exam-planner-settings-smartreview.js",
      "registerMethod": "__shbRegisterPage",
      "backTarget": "subjects"
    },
    {
      "id": "shbRemoteFlashcards",
      "registrationFile": "to me/js/45-android-remote-content.js",
      "registerMethod": "__shbRegisterPage",
      "backTarget": "subjects"
    }
  ],
  "backResolution": {
    "staticMapSource": "const BACKP in to me/js/09-app-features-v6.js",
    "wildcardRoute": "questions",
    "wildcardRule": "__shbGetBackTarget resolves to topics when the question bank is specialty-scoped, otherwise subjects.",
    "quizResultRule": "quizresult may return to quizhistory when opened from history; otherwise it returns to quiz.",
    "noGlobalBackMeaning": "null means the current BACKP map does not define the shared injected Back button for that route; it does not imply that the page has no internal navigation."
  },
  "routes": [
    {
      "id": "subjects",
      "title": "Home",
      "group": "home",
      "renderer": "core-switch",
      "backTarget": null,
      "addressable": true,
      "remoteV2": true,
      "remoteV3": true,
      "stateStores": [
        "shbace_qb_v6",
        "shbace_studytime_v1",
        "shbace_study_activity_days_v1"
      ],
      "note": "Landing screen and home study overview."
    },
    {
      "id": "grade",
      "title": "Grade",
      "group": "home",
      "renderer": "page-registry",
      "backTarget": null,
      "addressable": true,
      "remoteV2": false,
      "remoteV3": true,
      "stateStores": [
        "shbace_onboarding_v3_grade",
        "shbace_qb_v6"
      ],
      "note": "Registered in PAGES; remote V3 target only, not a V2 remote-UI target."
    },
    {
      "id": "specialties",
      "title": "Specialties",
      "group": "learning",
      "renderer": "core-switch",
      "backTarget": "subjects",
      "addressable": true,
      "remoteV2": true,
      "remoteV3": true,
      "stateStores": [
        "shbace_qb_v6",
        "shbace_pins_v1",
        "shbace_recent_v1"
