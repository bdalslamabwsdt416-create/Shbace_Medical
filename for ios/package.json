{
  "name": "shbace-medical",
  "version": "1.4.15",
  "private": true,
  "description": "Shbace Medical iOS PWA — To Me sidebar and navigation with preserved iOS onboarding and offline setup.",
  "scripts": {
    "android:debug": "cd android && ./gradlew :app:assembleDebug",
    "android:release": "cd android && ./gradlew :app:assembleRelease",
    "build:pwa": "node scripts/restore-ios-packed.js",
    "test": "node --test tests/offline-migration.test.js",
    "prebuild:pwa": "npm test"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0"
  }
}
