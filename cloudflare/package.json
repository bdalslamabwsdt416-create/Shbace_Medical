{
  "name": "shbace-cloudflare-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "sync:admin": "node scripts/sync-admin.mjs",
    "deploy": "npm run sync:admin && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply shbace-medical-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply shbace-medical-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261111.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
